# 复制为 .env 后按需修改（不复制也可，全部有默认值）
# server 对宿主机暴露的端口
SERVER_PORT=8080
# server 日志级别：debug | info | warn | error
LOG_LEVEL=info

# 以下变量在 compose 内已为容器设好默认值，一般无需改动：
# LISTEN_ADDR=:8080            server 监听地址（容器内）
# RULES_PATH=/etc/bannerf/rules.json  识别规则文件路径（容器内）
# SERVER_URL=http://server:8080        client 访问的 server 地址（容器内）
# INPUT_FILE=/data/input.json          client 读取的输入文件（容器内）
