{
  "version": 1,
  "_comment": "指纹识别规则（与代码解耦，修改后重启服务即可生效，无需重新编译）。priority 大者先匹配，banner 正则首个命中即返回；命名分组 product/version/os 命中后覆盖静态字段。banner 未命中时按 ports 端口提示降级识别，置信度上限 0.5。字节级匹配在 JSON 中写作 \\\\xHH（解码后为 Go 正则语法 \\xHH）。",
  "rules": [
    {
      "id": "ssh-openssh",
      "_comment": "SSH-2.0-OpenSSH_8.9p1 Ubuntu-3 / SSH-1.99-OpenSSH_4.3",
      "priority": 1000,
      "protocol": "SSH",
      "product": "OpenSSH",
      "confidence": 0.95,
      "ports": [22],
      "regex": "^SSH-[0-9.]+-(?P<product>OpenSSH)[_-](?P<version>[0-9][0-9A-Za-z._+\\-]*)(?:\\s+(?P<os>[A-Za-z][A-Za-z0-9._]*))?"
    },
    {
      "id": "ssh-generic",
      "_comment": "其他 SSH 实现，如 dropbear/libssh",
      "priority": 990,
      "protocol": "SSH",
      "confidence": 0.85,
