      "regex": "^SSH-[0-9.]+-(?P<product>[A-Za-z][0-9A-Za-z._-]*?)[_-](?P<version>[0-9][0-9A-Za-z._+\\-]*)(?:\\s+(?P<os>[A-Za-z][A-Za-z0-9._]*))?"
    },
